# 别乱穿 · 云端数据管理台 —— 配置模板
# 使用方法：复制本文件为 .env，填入腾讯云凭证，然后 `npm start`
# 注意：.env 已被 .gitignore 忽略，切勿提交真实密钥。

# 默认云环境 ID（一般无需修改）
TCB_ENV_ID=cloud-ai-fortune-d3eifhh01c8b796

# 可切换的云环境列表（逗号分隔）；前端顶栏下拉切换，缺省时仅含 TCB_ENV_ID
# TCB_ENV_IDS=cloud-ai-fortune-d3eifhh01c8b796,cloud1-d3gnb20je2d34acb4

# 腾讯云 API 凭证（第 1 个环境；须为能访问该环境的账号，如资源方账号「易经国学研习社」）
TCB_SECRET_ID=
TCB_SECRET_KEY=

# 第 2 个环境的独立凭证（跨账号场景；序号与 TCB_ENV_IDS 位置对应，如第 2 个环境用 _2）
# TCB_SECRET_ID_2=
# TCB_SECRET_KEY_2=

# 可选：服务端口与绑定地址（务必保持 127.0.0.1，不对外暴露）
ADMIN_PORT=8787
ADMIN_HOST=127.0.0.1

# 可选：设置后所有 /api 请求须携带请求头 x-admin-token: <此值>
# ADMIN_TOKEN=

# 可选：单文件上传上限（字节，默认 20MB）
# ADMIN_UPLOAD_LIMIT=20971520
