.dir-list {
    margin-top: 20rpx;
}

.dir-item {
    display: flex;
    align-items: center;
    padding: 20rpx 8rpx;
    border-bottom: 2rpx solid #f0f1f2;
}

.dir-item:active {
    background: #f5f8ff;
}

.dir-item:last-child {
    border-bottom: none;
}

.dir-icon {
    margin-right: 16rpx;
}

.dir-name {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.file-row {
    display: flex;
    align-items: center;
    padding: 22rpx 8rpx;
    border-bottom: 2rpx solid #f0f1f2;
}

.file-row:last-child {
    border-bottom: none;
}

.file-row .col-1 {
    display: flex;
    flex-direction: column;
}

.file-name {
    font-size: 26rpx;
    word-break: break-all;
}

.img-name {
    color: #1769e0;
}

.file-ops {
    display: flex;
    flex-direction: column;
    margin-left: 12rpx;
}

.file-ops .mini-btn {
    margin-bottom: 8rpx;
}
