.env-row {
    display: flex;
    align-items: center;
    padding: 22rpx 8rpx;
    border-bottom: 2rpx solid #f0f1f2;
}

.env-row:last-child {
    border-bottom: none;
}

.env-row .col-1 {
    display: flex;
    flex-direction: column;
}

.env-line {
    display: flex;
    align-items: center;
}

.env-id {
    font-weight: 600;
    word-break: break-all;
}

.env-ops {
    display: flex;
    flex-direction: column;
    margin-left: 12rpx;
}

.env-ops .mini-btn {
    margin-bottom: 8rpx;
}
